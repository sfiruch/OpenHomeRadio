# Normalise line endings in the repository; check out with the platform's native endings.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.slnx    text
*.props   text
*.targets text
*.md      text
*.json    text
*.yml     text
*.ps1     text eol=crlf
*.sh      text eol=lf

# Binary data
*.png        binary
*.complex16s binary
*.iq         binary
